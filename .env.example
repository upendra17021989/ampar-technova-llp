# Copy the Session pooler values from Supabase Dashboard > Connect.
# Use the JDBC prefix and require TLS. Never commit the real password.
DATABASE_URL=jdbc:postgresql://aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.your-project-ref
DATABASE_PASSWORD=replace-with-supabase-database-password
API_PORT=8080
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
